/* Local DexBlocks settings */
function applyDexSettings(){
  const reduced=localStorage.getItem('dexblocks-reduced-motion')==='true';
  const chat=localStorage.getItem('dexblocks-game-chat')!=='false';
  const motionInput=$('settingReducedMotion');
  const chatInput=$('settingGameChat');
  if(motionInput) motionInput.checked=reduced;
  if(chatInput) chatInput.checked=chat;
  document.documentElement.classList.toggle('reduced-motion',reduced);
  if(reduced) document.documentElement.style.scrollBehavior='auto';
}
if($('settingReducedMotion')){
  $('settingReducedMotion').addEventListener('change',e=>{
    localStorage.setItem('dexblocks-reduced-motion',String(e.target.checked));
    applyDexSettings();
  });
}
if($('settingGameChat')){
  $('settingGameChat').addEventListener('change',e=>{
    localStorage.setItem('dexblocks-game-chat',String(e.target.checked));
  });
}
applyDexSettings();

/* working dexblocks pause menu */
(() => {
  if (window.__dexPauseInstalled) return;
  window.__dexPauseInstalled = true;

  function setupPauseMenu() {
    if (document.getElementById('dexblocksPause')) return;

    const overlay = document.createElement('div');
    overlay.id = 'dexblocksPause';
    overlay.innerHTML = `
      <div class="dex-pause-screen">
        <header class="dex-pause-header">
          <div class="dex-pause-top-actions">
            <button id="dexPauseLeave">Leave</button>
            <button id="dexPauseReset">Reset</button>
            <button id="dexPauseResume">Resume</button>
          </div>
          <div class="dex-pause-game-info">
            <span id="dexPauseGameName">Your Game</span>
            <span id="dexPausePlayers">Players: 1</span>
          </div>
        </header>

        <main id="dexPauseHome" class="dex-pause-home">
          <h1>Paused</h1>
          <button id="dexPauseSettingsToggle" class="dex-pause-settings-button">Settings</button>
        </main>

        <main id="dexPauseSettings" class="dex-pause-settings-page" hidden>
          <h1>Settings</h1>
          <section class="dex-pause-setting-row">
            <label for="dexPauseVolume">Sound volume</label>
            <span id="dexPauseVolumeValue">100%</span>
            <input id="dexPauseVolume" type="range" min="0" max="100" value="100">
          </section>
          <button id="dexPauseSettingsBack">Back</button>
        </main>

        <footer class="dex-pause-social">
          <div class="dex-pause-social-heading">
            <h2>Players in this game</h2>
            <span id="dexPausePlayerCount">1 player</span>
          </div>
          <div id="dexPauseFriendList" class="dex-pause-friend-list"></div>
          <form id="dexPauseInviteForm" class="dex-pause-invite">
            <input id="dexPauseInviteName" autocomplete="off" placeholder="Enter a username to invite">
            <button type="submit">Add people</button>
          </form>
          <div id="dexPauseInviteStatus" role="status"></div>
        </footer>
      </div>`;
    document.body.appendChild(overlay);

    const resume = () => {
      overlay.classList.remove('open');
    };

    document.getElementById('dexPauseResume').addEventListener('click', resume);

    const settingsToggle = document.getElementById('dexPauseSettingsToggle');
    const settingsPanel = document.getElementById('dexPauseSettings');
    const volumeSlider = document.getElementById('dexPauseVolume');
    const volumeValue = document.getElementById('dexPauseVolumeValue');

    settingsToggle.addEventListener('click', () => {
      document.getElementById('dexPauseHome').hidden = true;
      settingsPanel.hidden = false;
    });

    document.getElementById('dexPauseSettingsBack').addEventListener('click', () => {
      settingsPanel.hidden = true;
      document.getElementById('dexPauseHome').hidden = false;
    });

    window.renderDexPausePlayers = () => {
      const list = document.getElementById('dexPauseFriendList');
      if (!list) return;
      list.replaceChildren();

      const people = [];
      if (typeof currentUser !== 'undefined' && currentUser?.username) {
        people.push({ username: currentUser.username, self: true });
      } else {
        people.push({ username: 'you', self: true });
      }

      if (typeof remotePlayers !== 'undefined') {
        for (const person of remotePlayers.values()) {
          if (person?.username && !people.some(p => p.username === person.username)) {
            people.push({ username: person.username, self: false });
          }
        }
      }

      for (const person of people) {
        const item = document.createElement('div');
        item.className = 'dex-pause-player';
        const name = document.createElement('span');
        name.textContent = person.username;
        const badge = document.createElement('span');
        badge.className = 'dex-pause-player-badge';
        badge.textContent = person.self ? 'YOU' : 'IN GAME';
        item.append(name, badge);
        list.appendChild(item);
      }

      const count = document.getElementById('dexPausePlayers');
      const countBottom = document.getElementById('dexPausePlayerCount');
      if (count) count.textContent = 'Players: ' + people.length;
      if (countBottom) countBottom.textContent =
        people.length + (people.length === 1 ? ' player' : ' players');
    };

    document.getElementById('dexPauseInviteForm').addEventListener('submit', e => {
      e.preventDefault();
      const input = document.getElementById('dexPauseInviteName');
      const status = document.getElementById('dexPauseInviteStatus');
      const username = input.value.trim();
      if (!username) {
        status.textContent = 'Enter a username first.';
        return;
      }
      if (typeof socket !== 'undefined' && socket) {
        socket.emit('invitePlayer', {
          username,
          gameId: typeof activeGameId !== 'undefined' ? activeGameId : null
        });
        status.textContent = 'Invite request sent.';
        input.value = '';
      } else {
        status.textContent = 'The game server is not connected.';
      }
    });

    volumeSlider.addEventListener('input', () => {
      const volume = Number(volumeSlider.value) / 100;
      volumeValue.textContent = volumeSlider.value + '%';

      document.querySelectorAll('audio, video').forEach(media => {
        media.volume = volume;
      });

      if (window.Howler && typeof window.Howler.volume === 'function') {
        window.Howler.volume(volume);
      }
    });

    document.getElementById('dexPauseReset').addEventListener('click', () => {
      if (typeof myPlayer !== 'undefined') {
        myPlayer.x = 450;
        myPlayer.y = 260;
      }

      if (typeof playerHeight !== 'undefined') playerHeight = 0;
      if (typeof verticalVelocity !== 'undefined') verticalVelocity = 0;
      if (typeof grounded !== 'undefined') grounded = true;
      if (typeof moveVelocityX !== 'undefined') moveVelocityX = 0;
      if (typeof moveVelocityZ !== 'undefined') moveVelocityZ = 0;

      if (typeof updateAvatarPosition === 'function') updateAvatarPosition();
      if (typeof sendMyPosition === 'function') sendMyPosition();

      overlay.classList.remove('open');
    });

    document.getElementById('dexPauseLeave').addEventListener('click', () => {
      overlay.classList.remove('open');

      // Use the existing leave/exit control so the game cleanup stays intact.
      const controls = [...document.querySelectorAll('button, [role="button"], a')]
        .filter(el => !overlay.contains(el) && el.offsetWidth > 0 && el.offsetHeight > 0);

      const leaveControl = controls.find(el =>
        /^(leave|leave game|exit game|back to games|return to games)$/i
          .test((el.innerText || el.textContent || '').trim())
      );

      if (leaveControl) {
        leaveControl.click();
        return;
      }

      for (const name of ['leaveGame', 'exitGame', 'closeGame']) {
        if (typeof window[name] === 'function') {
          window[name]();
          return;
        }
      }

      alert('Could not find the existing leave-game action. The game was not closed.');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPauseMenu, { once: true });
  } else {
    setupPauseMenu();
  }

  window.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (typeof activeGameId !== 'undefined' && !activeGameId) return;

    const overlay = document.getElementById('dexblocksPause');
    if (!overlay) return;

    e.preventDefault();
    e.stopImmediatePropagation();
    const gameName = document.getElementById('dexPauseGameName');
    const playersLabel = document.getElementById('dexPausePlayers');

    if (gameName) {
      const title = document.querySelector('[data-game-name], .game-title, #gameTitle');
      gameName.textContent =
        (title && title.textContent.trim()) ||
        (typeof activeGameId !== 'undefined' && activeGameId ? String(activeGameId) : 'Your Game');
    }

    if (playersLabel) {
      const count = typeof remotePlayers !== 'undefined' ? remotePlayers.size + 1 : 1;
      playersLabel.textContent = 'Players: ' + count;
    }

    if (window.renderDexPausePlayers) window.renderDexPausePlayers();
    overlay.classList.toggle('open');
  }, true);
})();

/* DexBlocks clickable game details */
(() => {
  if (window.__dexGameDetailsInstalled) return;
  window.__dexGameDetailsInstalled = true;

  let selectedCard = null;
  let bypass = false;
  let vote = 0;

  const cardSelector = [
    '[data-game-id]',
    '.game',
    '.game-card',
    '.game-item',
    '.game-tile',
    '.experience-card'
  ].join(',');

  const getTitle = card => {
    const el = card.querySelector(
      '[data-game-name], .game-title, .game-name, h2, h3, h4'
    );
    return (
      el?.dataset.gameName ||
      el?.textContent?.trim() ||
      card.dataset.gameName ||
      card.dataset.title ||
      'Untitled game'
    ).trim();
  };

  function setup() {
    if (document.getElementById('dexGameDetails')) return;

    const modal = document.createElement('div');
    modal.id = 'dexGameDetails';
    modal.innerHTML = `
      <section class="dex-details-card">
        <button class="dex-details-close" aria-label="Close">×</button>
        <div class="dex-details-banner"><span>GAME</span></div>
        <div class="dex-details-content">
          <h2 class="dex-details-title">Game</h2>
          <p class="dex-details-description">Ready to play?</p>
          <div class="dex-details-actions">
            <button class="dex-details-like">▲ Like <span>0</span></button>
            <button class="dex-details-dislike">▼ Dislike <span>0</span></button>
            <button class="dex-details-join">▶ Join</button>
          </div>
        </div>
      </section>`;

    document.body.appendChild(modal);

    const close = () => {
      modal.classList.remove('visible');
      selectedCard = null;
    };

    modal.querySelector('.dex-details-close').onclick = close;
    modal.addEventListener('click', e => {
      if (e.target === modal) close();
    });

    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && modal.classList.contains('visible')) close();
    });

    function updateVoteButtons() {
      modal.querySelector('.dex-details-like').classList.toggle('selected', vote === 1);
      modal.querySelector('.dex-details-dislike').classList.toggle('selected', vote === -1);
    }

    function voteFor(value) {
      if (!selectedCard) return;

      const id = selectedCard.dataset.gameId ||
        selectedCard.dataset.title ||
        getTitle(selectedCard);

      const key = 'dexblocks-vote-' + id;
      const oldVote = vote;
      const newVote = oldVote === value ? 0 : value;

      try {
        const counts = JSON.parse(localStorage.getItem(key + '-counts') || '{"up":0,"down":0}');
        if (oldVote === 1) counts.up = Math.max(0, counts.up - 1);
        if (oldVote === -1) counts.down = Math.max(0, counts.down - 1);
        if (newVote === 1) counts.up++;
        if (newVote === -1) counts.down++;
        localStorage.setItem(key + '-counts', JSON.stringify(counts));
        localStorage.setItem(key, String(newVote));
        vote = newVote;
        modal.querySelector('.dex-details-like span').textContent = counts.up;
        modal.querySelector('.dex-details-dislike span').textContent = counts.down;
      } catch {}
      updateVoteButtons();
    }

    modal.querySelector('.dex-details-like').onclick = () => voteFor(1);
    modal.querySelector('.dex-details-dislike').onclick = () => voteFor(-1);

    modal.querySelector('.dex-details-join').onclick = () => {
      if (!selectedCard) return;

      const card = selectedCard;
      const joinButton = card.querySelector(
        '[data-action="join"], .join-button, .game-join, button'
      );

      close();
      bypass = true;
      try {
        if (joinButton) joinButton.click();
        else card.click();
      } finally {
        setTimeout(() => { bypass = false; }, 300);
      }
    };

    document.addEventListener('click', e => {
      if (bypass || modal.contains(e.target)) return;

      const card = e.target.closest(cardSelector);
      if (!card || !document.body.contains(card)) return;

      if (e.target.closest(
        'button, a, input, select, textarea, [data-action="join"], .join-button'
      )) return;

      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();

      selectedCard = card;
      vote = 0;

      const title = getTitle(card);
      modal.querySelector('.dex-details-title').textContent = title;

      const description = card.querySelector(
        '.game-description, .game-desc, [data-game-description], p'
      );
      modal.querySelector('.dex-details-description').textContent =
        description?.textContent?.trim() || 'Jump in and start playing.';

      const banner = modal.querySelector('.dex-details-banner');
      banner.replaceChildren();
      const sourceImage = card.querySelector('img');
      if (sourceImage?.src) {
        const img = document.createElement('img');
        img.src = sourceImage.src;
        img.alt = title;
        banner.appendChild(img);
      } else {
        const label = document.createElement('span');
        label.textContent = 'GAME';
        banner.appendChild(label);
      }

      const id = card.dataset.gameId || card.dataset.title || title;
      try {
        const counts = JSON.parse(
          localStorage.getItem('dexblocks-vote-' + id + '-counts') ||
          '{"up":0,"down":0}'
        );
        vote = Number(localStorage.getItem('dexblocks-vote-' + id) || 0);
        modal.querySelector('.dex-details-like span').textContent = counts.up || 0;
        modal.querySelector('.dex-details-dislike span').textContent = counts.down || 0;
      } catch {}

      updateVoteButtons();
      modal.classList.add('visible');
    }, true);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setup, { once: true });
  } else {
    setup();
  }
})();


/* Persist DexBlocks download links */
(() => {
  const key = 'dexblocks-saved-downloads';
  document.addEventListener('click', e => {
    const a = e.target.closest('a[download], a[href]');
    if (!a || !/download|file/i.test((a.textContent || '') + ' ' + a.href)) return;
    try {
      const saved = JSON.parse(localStorage.getItem(key) || '[]');
      const item = { name: (a.download || a.textContent || 'download').trim(), url: a.href };
      if (!saved.some(x => x.url === item.url)) saved.push(item);
      localStorage.setItem(key, JSON.stringify(saved));
    } catch (_) {}
  }, true);
})();
