let token = localStorage.getItem('dexblocks-token') || '';
let currentUser = null;
let socket = null;
let recent = JSON.parse(localStorage.getItem('dexblocks-recent') || '[]');
const $ = id => document.getElementById(id);
const esc = s => String(s ?? '').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(url, options={}) {
  const headers = {...(options.headers||{})};
  if (token) headers.Authorization = 'Bearer ' + token;
  if (options.body && !(options.body instanceof FormData)) headers['Content-Type']='application/json';
  const r=await fetch(url,{...options,headers});
  const data=await r.json().catch(()=>({}));
  if(!r.ok) throw new Error(data.error || 'Request failed.');
  return data;
}
function status(msg){$('accountStatus').textContent=msg}
function showPage(page){
  document.querySelectorAll('.page').forEach(p=>p.classList.toggle('hidden',p.id!==page));
  document.querySelectorAll('.nav').forEach(b=>b.classList.toggle('active',b.dataset.page===page));
  if(page==='recent') renderRecent();
  if(page==='studio'&&token) loadFiles();
}
document.querySelectorAll('.nav').forEach(b=>b.onclick=()=>showPage(b.dataset.page));
$('explore').onclick=()=>{showPage('home');$('games').scrollIntoView({behavior:'smooth'})};
async function refreshMe(){
  if(!token){currentUser=null;updateWho();disconnectChat();return}
  try{currentUser=await api('/api/me');updateWho();connectChat()}
  catch{token='';localStorage.removeItem('dexblocks-token');currentUser=null;updateWho();disconnectChat()}
}
function updateWho(){
  const u=currentUser;
  $('who').innerHTML=u?`${esc(u.username)} ${u.verified?'<span class="badge verified">✓ VERIFIED</span>':''} ${['owner','admin'].includes(u.role)?'<span class="badge">ADMIN</span>':''}`:'not signed in';
}
function card(g){
  const isRecent=recent.includes(g.id);
  return `<article class="game" data-id="${esc(g.id)}"><div class="cover">${esc(g.title.slice(0,2).toUpperCase())}</div><div class="gamebody"><h3>${esc(g.title)}</h3><p>${esc(g.description||'A DexBlocks experience.')}</p><div class="meta"><span>${esc(g.category||'Community')}</span><span>${Number(g.visits||0).toLocaleString()} visits</span></div><div class="meta"><span>by ${esc(g.owner||'Dexblocks')}</span><span>${isRecent?'RECENT':'PLAY'}</span></div></div></article>`;
}
async function loadGames(){
  try{
    const games=await api('/api/games');
    const q=$('search').value.toLowerCase();
    const filtered=games.filter(g=>(g.title+' '+g.description+' '+g.category+' '+g.owner).toLowerCase().includes(q));
    $('games').innerHTML=filtered.map(card).join('')||'<p class="muted">No experiences found.</p>';
    $('games').querySelectorAll('.game').forEach(el=>el.onclick=()=>visit(el.dataset.id,games));
    renderRecent(games);
  }catch(e){$('games').innerHTML=`<p class="muted">${esc(e.message)}</p>`}
}
async function visit(id,games){
  try {
    const list = games || await api('/api/games');
    const game = list.find(g => g.id === id);
    if (!game) throw new Error('Experience not found.');
    await api('/api/games/'+encodeURIComponent(id)+'/visit',{method:'POST'});
    recent=[id,...recent.filter(x=>x!==id)].slice(0,20);
    localStorage.setItem('dexblocks-recent',JSON.stringify(recent));
    await loadGames();
    openGame(game);
  } catch(e) { alert(e.message); }
}
function renderRecent(games){
  if(!games) {api('/api/games').then(gs=>renderRecent(gs)).catch(()=>{});return}
  const items=recent.map(id=>games.find(g=>g.id===id)).filter(Boolean);
  $('recentGames').innerHTML=items.map(card).join('')||'<p class="muted">Visit an experience and it will show up here.</p>';
  $('recentGames').querySelectorAll('.game').forEach(el=>el.onclick=()=>visit(el.dataset.id,games));
}
$('search').addEventListener('input',loadGames);
$('register').onclick=async()=>{
  try{await api('/api/register',{method:'POST',body:JSON.stringify({username:$('regName').value,password:$('regPass').value})});status('Account created. Sign in to continue.');$('loginName').value=$('regName').value;$('loginPass').value=$('regPass').value}
  catch(e){status(e.message)}
};
$('login').onclick=async()=>{
  try{const d=await api('/api/login',{method:'POST',body:JSON.stringify({username:$('loginName').value,password:$('loginPass').value})});token=d.token;localStorage.setItem('dexblocks-token',token);await refreshMe();status('Signed in successfully.');}
  catch(e){status(e.message)}
};
$('logout').onclick=()=>{token='';currentUser=null;localStorage.removeItem('dexblocks-token');disconnectChat();updateWho();status('Signed out.')};
$('createGame').onclick=async()=>{
  try{const g=await api('/api/games',{method:'POST',body:JSON.stringify({title:$('gameTitle').value,description:$('gameDescription').value,category:$('gameCategory').value})});$('gameTitle').value='';$('gameDescription').value='';$('gameCategory').value='';$('uploadStatus').textContent='Created '+g.title;await loadGames();showPage('home')}
  catch(e){$('uploadStatus').textContent=e.message}
};
$('uploadFile').onclick=async()=>{
  const f=$('rbxfile').files[0];if(!f){$('uploadStatus').textContent='Choose an .rbxm or .rbxl file first.';return}
  const form=new FormData();form.append('file',f);
  try{const d=await api('/api/studio/upload',{method:'POST',body:form});$('uploadStatus').textContent=`Stored ${d.originalName} (${d.size} bytes). ${d.note}`;loadFiles()}
  catch(e){$('uploadStatus').textContent=e.message}
};
async function loadFiles(){
  try{const files=await api('/api/studio/files');$('files').innerHTML=files.map(f=>`<li>${esc(f.name)} — ${(f.size/1024).toFixed(1)} KB</li>`).join('')||'<li>No uploads yet.</li>'}
  catch(e){$('files').innerHTML=`<li>${esc(e.message)}</li>`}
}
$('refreshFiles').onclick=loadFiles;
function disconnectChat(){if(socket){socket.disconnect();socket=null}$('socketState').textContent='sign in to connect'}
function connectChat(){
  if(!token||socket)return;
  socket=io({auth:{token}});
  socket.on('connect',()=>{$('socketState').textContent='connected';socket.emit('joinRoom',activeGameId?'game-'+activeGameId:($('room').value||'lobby'));if(activeGameId)sendMyPosition()});
  socket.on('disconnect',()=>{$('socketState').textContent='disconnected'});
  socket.on('connect_error',e=>{$('socketState').textContent=e.message});
  socket.on('system',d=>addChat('DexBlocks',d.message,'system'));
  socket.on('chat',m=>addChat(m.username,m.message,m.role,m.verified));
  socket.on('chatError',d=>addChat('Chat',d.message,'system'));
  socket.on('playerMove',p=>{if(p&&p.id&&p.id!==myPlayerId){remotePlayers.set(p.id,p);drawWorld()}});
  socket.on('playerLeft',p=>{if(p&&p.id){remotePlayers.delete(p.id);drawWorld()}});
}
function addChat(name,msg,role,verified=false){
  const el=document.createElement('div');el.className='chatmsg';
  el.innerHTML=`<strong>${esc(name)} ${role==='owner'||role==='admin'?'<span class="badge">ADMIN</span>':''} ${verified?'<span class="badge verified">✓ VERIFIED</span>':''}</strong>${esc(msg)}`;
  $('chatlog').appendChild(el);$('chatlog').scrollTop=$('chatlog').scrollHeight;
}
$('joinRoom').onclick=()=>{if(!socket)return alert('Sign in first.');socket.emit('joinRoom',$('room').value)};
function sendChat(){if(!socket)return alert('Sign in first.');const msg=$('chatInput').value;socket.emit('chat',msg);$('chatInput').value=''}
$('sendChat').onclick=sendChat;$('chatInput').addEventListener('keydown',e=>{if(e.key==='Enter')sendChat()});
$('loadUsers').onclick=async()=>{
  try{
    const users=await api('/api/admin/users');
    $('users').innerHTML=users.map(u=>`<div class="userrow"><span>${esc(u.username)} ${u.verified?'<span class="badge verified">✓ VERIFIED</span>':''} <span class="muted">${esc(u.role)}</span></span><button data-user="${esc(u.username)}" data-verified="${!u.verified}" class="secondary">${u.verified?'Remove verified':'Verify'}</button></div>`).join('');
    $('users').querySelectorAll('button[data-user]').forEach(b=>b.onclick=async()=>{try{await api('/api/admin/users/'+encodeURIComponent(b.dataset.user)+'/verify',{method:'POST',body:JSON.stringify({verified:b.dataset.verified==='true'})});$('loadUsers').click()}catch(e){alert(e.message)}});
  }catch(e){$('users').textContent=e.message}
};
refreshMe();loadGames();



// DexBlocks 3D game engine
let activeGameId = null, activeGame = null;
let myPlayerId = 'local-' + Math.random().toString(36).slice(2);
let myPlayer = {x:450,y:260};
let remotePlayers = new Map();
let worldFrame = 0;
let heldKeys = new Set();
const world = $('world');
let renderer, scene, camera, clock, avatar, ground;
let remoteMeshes = new Map();
let gameObjects = [];
let gameChatReady = false;

function makeAvatar(color) {
  const group = new THREE.Group();
  const mat = new THREE.MeshStandardMaterial({color});
  const skin = new THREE.MeshStandardMaterial({color:0xe5b995});
  const dark = new THREE.MeshStandardMaterial({color:0x252834});
  function part(w,h,d,y,material,x=0,z=0) {
    const mesh = new THREE.Mesh(new THREE.BoxGeometry(w,h,d),material);
    mesh.position.set(x,y,z);
    mesh.castShadow = true;
    mesh.receiveShadow = true;
    group.add(mesh);
    return mesh;
  }
  part(.75,.9,.4,1.25,mat);
  part(.62,.62,.62,2,skin);
  part(.22,.18,.12,2.08,dark,-.16,-.31);
  part(.22,.18,.12,2.08,dark,.16,-.31);
  part(.25,.65,.3,.48,dark,-.2,0);
  part(.25,.65,.3,.48,dark,.2,0);
  part(.22,.7,.25,1.3,mat,-.49,0);
  part(.22,.7,.25,1.3,mat,.49,0);
  return group;
}

function setupGameChat() {
  if (gameChatReady) return;
  gameChatReady = true;
  const panel = $('playerList').parentElement;
  panel.insertAdjacentHTML('beforeend',
    '<h3 style="margin-top:22px">Game chat</h3>' +
    '<div id="gameChatLog" style="height:180px;overflow:auto;background:#0d0e13;border:1px solid #30313d;border-radius:8px;padding:8px;font-size:12px"></div>' +
    '<div style="display:flex;gap:6px;margin-top:8px">' +
    '<input id="gameChatInput" maxlength="180" placeholder="Message..." style="width:0;flex:1;padding:9px">' +
    '<button id="gameChatSend" style="padding:8px">Send</button></div>');
  $('gameChatSend').onclick=sendGameChat;
  $('gameChatInput').addEventListener('keydown',e=>{
    if(e.key==='Enter') sendGameChat();
    e.stopPropagation();
  });
}

function sendGameChat() {
  const input=$('gameChatInput');
  if(!socket || !socket.connected) {
    addGameChat('DexBlocks','sign in to use game chat');
    return;
  }
  const msg=input.value.trim();
  if(!msg) return;
  socket.emit('chat',msg);
  input.value='';
}

function addGameChat(name,msg,role,verified=false) {
  const log=$('gameChatLog');
  if(!log) return;
  const row=document.createElement('div');
  row.style.cssText='padding:5px 0;border-bottom:1px solid #292a34;overflow-wrap:anywhere';
  const who=document.createElement('strong');
  who.textContent=name+': ';
  const body=document.createElement('span');
  body.textContent=msg;
  row.append(who,body);
  log.appendChild(row);
  while(log.children.length>80) log.firstChild.remove();
  log.scrollTop=log.scrollHeight;
}

function drawWorld() {
  if(!renderer || !scene || !camera) return;
  renderer.render(scene,camera);
  const list=$('playerList');
  if(!list) return;
  list.innerHTML='';
  const people=[{id:myPlayerId,username:currentUser?.username||'you',color:'#8b78ff'},...remotePlayers.values()];
  for(const person of people) {
    const row=document.createElement('div');
    row.className='player-row';
    const dot=document.createElement('span');
    dot.className='player-dot';
    dot.style.background=person.color||'#e39a53';
    const name=document.createElement('span');
    name.textContent=(person.username||'player')+(person.id===myPlayerId?' (you)':'');
    row.append(dot,name);
    list.appendChild(row);
  }
}

function sendMyPosition() {
  if(!socket || !socket.connected || !activeGameId || !currentUser) return;
  socket.emit('playerMove',{x:myPlayer.x,y:myPlayer.y});
}

function buildWorld() {
  if(renderer) {
    renderer.dispose();
    renderer=null;
  }
  scene=new THREE.Scene();
  scene.background=new THREE.Color('#91b9d2');
  scene.fog=new THREE.Fog('#91b9d2',28,85);
  camera=new THREE.PerspectiveCamera(70,1,.1,200);
  clock=new THREE.Clock();

  renderer=new THREE.WebGLRenderer({canvas:world,antialias:true});
  renderer.setPixelRatio(Math.min(window.devicePixelRatio||1,2));
  renderer.shadowMap.enabled=true;
  renderer.shadowMap.type=THREE.PCFSoftShadowMap;
  renderer.outputColorSpace=THREE.SRGBColorSpace;

  scene.add(new THREE.HemisphereLight(0xdceeff,0x65734d,2));
  const sun=new THREE.DirectionalLight(0xfff0d8,3);
  sun.position.set(-12,22,10);
  sun.castShadow=true;
  sun.shadow.mapSize.set(2048,2048);
  scene.add(sun);

  const grass=new THREE.MeshStandardMaterial({color:'#6d9b59'});
  ground=new THREE.Mesh(new THREE.BoxGeometry(100,1,100),grass);
  ground.position.y=-.55;
  ground.receiveShadow=true;
  scene.add(ground);

  const pathMat=new THREE.MeshStandardMaterial({color:'#b9a17a'});
  const road=new THREE.Mesh(new THREE.BoxGeometry(8,.04,100),pathMat);
  road.position.set(0,-.01,0);
  road.receiveShadow=true;
  scene.add(road);
  const cross=new THREE.Mesh(new THREE.BoxGeometry(100,.04,7),pathMat);
  cross.position.set(0,0,0);
  scene.add(cross);

  const mats=['#789b55','#7e8e9d','#b68b62','#a7a7a7','#547c9a'].map(
    c=>new THREE.MeshStandardMaterial({color:c,roughness:.9})
  );
  let seed=42;
  const rand=()=>{seed=(seed*1664525+1013904223)>>>0;return seed/4294967296};
  for(let i=0;i<100;i++) {
    let x=(rand()-.5)*75,z=(rand()-.5)*75;
    if(Math.abs(x)<7 || Math.abs(z)<5) continue;
    const h=1+rand()*4;
    const mesh=new THREE.Mesh(new THREE.BoxGeometry(1.5+rand()*2,h,1.5+rand()*2),mats[i%mats.length]);
    mesh.position.set(x,h/2,z);
    mesh.castShadow=true;
    mesh.receiveShadow=true;
    scene.add(mesh);
    gameObjects.push(mesh);
  }

  avatar=makeAvatar('#8b78ff');
  scene.add(avatar);
  for(const mesh of remoteMeshes.values()) scene.remove(mesh);
  remoteMeshes.clear();

  for(const person of remotePlayers.values()) {
    const mesh=makeAvatar(person.color||'#e39a53');
    scene.add(mesh);
    remoteMeshes.set(person.id,mesh);
  }
  resizeGame();
  updateAvatarPosition();
  drawWorld();
}

function updateAvatarPosition() {
  if(!avatar) return;
  avatar.position.set((myPlayer.x-450)/25,0,(myPlayer.y-260)/25);
  const target=new THREE.Vector3(avatar.position.x+8,6,avatar.position.z+11);
  camera.position.lerp(target,.16);
  camera.lookAt(avatar.position.x,1,avatar.position.z);
}

function resizeGame() {
  if(!renderer || !camera || !$('playModal') || $('playModal').classList.contains('hidden')) return;
  const stage=$('world').parentElement;
  const w=Math.max(1,stage.clientWidth),h=Math.max(1,stage.clientHeight);
  renderer.setSize(w,h,false);
  camera.aspect=w/h;
  camera.updateProjectionMatrix();
  drawWorld();
}

function openGame(game) {
  activeGame=game;
  activeGameId=game.id;
  myPlayer={x:450,y:260};
  remotePlayers.clear();
  $('playTitle').textContent=game.title;
  $('playStatus').textContent=currentUser?'connecting to multiplayer...':'solo mode · sign in for multiplayer';
  $('playModal').classList.remove('hidden');
  setupGameChat();
  if($('gameChatLog')) $('gameChatLog').innerHTML='';
  if(socket && socket.connected) socket.emit('joinRoom','game-'+game.id);
  buildWorld();
  if(worldFrame) cancelAnimationFrame(worldFrame);
  gameLoop();
  resizeGame();
}

function closeGame() {
  activeGameId=null;
  activeGame=null;
  heldKeys.clear();
  remotePlayers.clear();
  if(socket && socket.connected) socket.emit('joinRoom',$('room').value||'lobby');
  $('playModal').classList.add('hidden');
  if(worldFrame) cancelAnimationFrame(worldFrame);
  worldFrame=0;
}

$('leaveGame').onclick=closeGame;
window.addEventListener('resize',resizeGame);
window.addEventListener('keydown',e=>{
  if(!activeGameId) return;
  if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key)) e.preventDefault();
  heldKeys.add(e.key.toLowerCase());
  if(e.key==='Escape') closeGame();
});
window.addEventListener('keyup',e=>heldKeys.delete(e.key.toLowerCase()));
window.addEventListener('blur',()=>heldKeys.clear());

function gameLoop() {
  if(!activeGameId || !renderer) return;
  const delta=Math.min(clock.getDelta(),.05);
  let dx=0,dz=0;
  if(heldKeys.has('a')||heldKeys.has('arrowleft')) dx-=1;
  if(heldKeys.has('d')||heldKeys.has('arrowright')) dx+=1;
  if(heldKeys.has('w')||heldKeys.has('arrowup')) dz-=1;
  if(heldKeys.has('s')||heldKeys.has('arrowdown')) dz+=1;
  if(dx||dz) {
    const length=Math.hypot(dx,dz)||1;
    myPlayer.x=Math.max(200,Math.min(700,myPlayer.x+dx/length*100*delta));
    myPlayer.y=Math.max(80,Math.min(440,myPlayer.y+dz/length*100*delta));
    updateAvatarPosition();
    if(Math.floor(performance.now()/100)%2===0) sendMyPosition();
  }

  for(const [id,p] of remotePlayers) {
    let mesh=remoteMeshes.get(id);
    if(!mesh) {
      mesh=makeAvatar(p.color||'#e39a53');
      scene.add(mesh);
      remoteMeshes.set(id,mesh);
    }
    mesh.position.set((p.x-450)/25,0,(p.y-260)/25);
  }
  for(const [id,mesh] of remoteMeshes) {
    if(!remotePlayers.has(id)) {
      scene.remove(mesh);
      remoteMeshes.delete(id);
    }
  }
  renderer.render(scene,camera);
  worldFrame=requestAnimationFrame(gameLoop);
}

// Keep multiplayer events connected to the 3D scene and in-game chat.
if(socket) {
  socket.on('playerMove',p=>{
    if(p && p.id && p.id!==myPlayerId) {
      remotePlayers.set(p.id,p);
      drawWorld();
    }
  });
  socket.on('playerLeft',p=>{
    if(p && p.id) {
      remotePlayers.delete(p.id);
      drawWorld();
    }
  });
  socket.on('chat',m=>{
    if(activeGameId) addGameChat(m.username,m.message,m.role,m.verified);
  });
  socket.on('system',d=>{
    if(activeGameId) addGameChat('DexBlocks',d.message);
  });
  socket.on('chatError',d=>{
    if(activeGameId) addGameChat('Chat',d.message);
  });
}
